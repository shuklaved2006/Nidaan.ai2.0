[
  {
    "source": "/api/**",
    "target": {
      "type": "appsail",
      "name": "backend"
    },
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH",
      "OPTIONS"
    ]
  },
  {
    "source": "/**",
    "target": {
      "type": "web_client",
      "name": "client"
    },
    "methods": [
      "GET"
    ]
  }
]
